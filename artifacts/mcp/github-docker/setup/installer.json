{"artifact":"mcp/github-docker","capabilities":["keychain","filesystem","docker","network","process"],"help_urls":[{"label":"Create a fine-grained GitHub personal access token","url":"https://github.com/settings/personal-access-tokens/new"},{"label":"GitHub MCP server authentication documentation","url":"https://github.com/github/github-mcp-server/tree/v1.9.0#local-github-mcp-server"},{"label":"GitHub personal access token guidance","url":"https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"}],"inputs":[{"help_url":"https://github.com/settings/personal-access-tokens/new","id":"github_token","prompt":"Paste a least-privilege GitHub personal access token for the MCP server","type":"secret"}],"platforms":["darwin"],"protocol_version":2,"purpose":"Pull the reviewed GitHub MCP image, keep its token in macOS Keychain, and expose only a Keychain lookup to new shells.","required_tools":["/usr/bin/security","docker"],"schema_version":2,"steps":[{"id":"image","use":"docker.pull@1","with":{"image":"ghcr.io/github/github-mcp-server@sha256:881b53d6f75f69bdbc1b5b10fc2f1361717c19054143b3a8529fb5c32061a50e","official_url":"https://github.com/github/github-mcp-server/pkgs/container/github-mcp-server"}},{"id":"token","use":"macos-keychain.store@1","with":{"account":"default","input":"github_token","service":"aart/mcp/github-docker"}},{"id":"shell","use":"shell.env-from-keychain@1","with":{"file":"~/.zshrc","variables":{"GITHUB_PERSONAL_ACCESS_TOKEN":{"account":"default","service":"aart/mcp/github-docker"}}}},{"id":"restart","use":"restart.notice@1","with":{"message":"Open a new shell and restart the MCP host so it inherits GITHUB_PERSONAL_ACCESS_TOKEN."}}]}
