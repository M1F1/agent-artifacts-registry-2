{"artifact":"mcp/github-enterprise-docker","capabilities":["keychain","filesystem","docker","network","process"],"help_urls":[{"label":"Create a company GitHub Enterprise personal access token","url":"https://github.dev.global.company.org/settings/tokens/new"},{"label":"GitHub MCP server authentication documentation","url":"https://github.com/github/github-mcp-server/tree/v1.9.0#local-github-mcp-server"},{"label":"GitHub personal access token guidance","url":"https://docs.github.com/en/enterprise-server@latest/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens"}],"inputs":[{"help_url":"https://github.dev.global.company.org/settings/tokens/new","id":"github_enterprise_token","prompt":"Paste a least-privilege personal access token for the company GitHub Enterprise MCP server","type":"secret"}],"platforms":["darwin"],"protocol_version":1,"purpose":"Pull the reviewed GitHub MCP image, keep the company token in macOS Keychain, and expose only a Keychain lookup to new shells.","required_tools":["/usr/bin/security","docker"],"schema_version":1,"steps":[{"id":"image","use":"docker.pull@1","with":{"image":"ghcr.io/github/github-mcp-server@sha256:881b53d6f75f69bdbc1b5b10fc2f1361717c19054143b3a8529fb5c32061a50e","official_url":"https://github.com/github/github-mcp-server/pkgs/container/github-mcp-server"}},{"id":"token","use":"macos-keychain.store@1","with":{"account":"default","input":"github_enterprise_token","service":"aart/mcp/github-enterprise-docker"}},{"id":"shell","use":"shell.env-from-keychain@1","with":{"file":"~/.zshrc","variables":{"GITHUB_ENTERPRISE_PERSONAL_ACCESS_TOKEN":{"account":"default","service":"aart/mcp/github-enterprise-docker"}}}},{"id":"restart","use":"restart.notice@1","with":{"message":"Open a new shell and restart Claude Code or Tabnine CLI so it inherits GITHUB_ENTERPRISE_PERSONAL_ACCESS_TOKEN."}}]}
